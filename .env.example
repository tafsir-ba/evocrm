# Phase 0 — required for local development
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
MONGODB_URI=mongodb://localhost:27017/evocrm

# Phase 2 — Auth.js / NextAuth (not required until auth phase)
# NEXTAUTH_URL=http://localhost:3000
# NEXTAUTH_SECRET=replace-with-openssl-rand-base64-32
# GOOGLE_CLIENT_ID=replace-with-google-client-id
# GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
#
# Google Cloud redirect URI must be EXACTLY (not /api/auth/google/callback):
#   http://localhost:3000/api/auth/callback/google
#   https://crm.evo-home.ch/api/auth/callback/google

# Phase 8 — DigitalOcean Spaces
# DIGITALOCEAN_SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
# DIGITALOCEAN_SPACES_REGION=nyc3
# DIGITALOCEAN_SPACES_BUCKET=evocrm-files
# DIGITALOCEAN_SPACES_KEY=replace-with-spaces-key
# DIGITALOCEAN_SPACES_SECRET=replace-with-spaces-secret

# Phase 10 — Email / cron
# RESEND_API_KEY=replace-with-resend-key
# EMAIL_FROM=noreply@example.com
# EMAIL_REPLY_TO=support@example.com
# CRON_SECRET=replace-with-openssl-rand-base64-32

# Phase 11 — Stripe (optional)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Phase 14 — Platform admin feedback triage (comma-separated emails)
# PLATFORM_ADMIN_EMAILS=ops@example.com,founder@example.com
